# --- Majburiy ---
# @BotFather bergan token (Railway'da vaqtincha "taomkeldi_bot" nomi ham qabul qilinadi)
BOT_TOKEN=
# Platforma administratorlari: Telegram ID'lar, vergul bilan. (ADMIN_CHAT_ID — eski nom, ham o'qiladi)
PLATFORM_ADMIN_IDS=

# --- Saqlash ---
# Ma'lumotlar papkasi. Railway'da volume mount yo'li: DATA_DIR=/data (volume bo'lmasa har deployda baza o'chadi!)
DATA_DIR=./data
# Ixtiyoriy: aniq yo'llar (standart: DATA_DIR/taomkeldi.db va DATA_DIR/uploads)
# DB_PATH=
# UPLOADS_DIR=

# Bot username (ixtiyoriy: bot ishga tushganda o'zi aniqlaydi; faqat HTTP rejimida taklif havolasi uchun)
# BOT_USERNAME=taomkeldi_bot

# --- HTTP / Mini App ---
# PORT=3000
# Mini App manzili, faqat HTTPS (Railway domeni, masalan https://<servis>.up.railway.app)
# WEBAPP_URL=
# initData eskirish chegarasi, soniya (standart 86400)
# INITDATA_MAX_AGE_SEC=86400
# Rasm yuklash chegarasi, bayt (standart 5 MB)
# UPLOAD_MAX_BYTES=5242880

# --- To'lovlar ---
# Onlayn to'lov (Telegram Payments): @BotFather → Payments → provayder tokeni. Bo'lmasa onlayn ko'rsatilmaydi.
# PAYMENT_PROVIDER_TOKEN=
# PAYMENT_CURRENCY=UZS
# Karta o'tkazmasi / onlayn to'lov kutish muddati, daqiqa
# PAYMENT_TIMEOUT_MIN=30

# --- Xarita va manzil qidiruvi ---
# Plitkalar (standart: OSM — faqat kichik yuklama uchun). Provayder o'zgarsa attribution'ni ham yozing.
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_ATTRIBUTION=© OpenStreetMap contributors
# Manzil qidiruvi (Nominatim). 0 — o'chirish.
# GEOCODER_ENABLED=1
# GEOCODER_URL=https://nominatim.openstreetmap.org
# GEOCODER_USER_AGENT=Taomkeldi/0.5 (Telegram food delivery app, Jizzakh)

# --- Faqat lokal ishlab chiqish (production'da avtomatik o'chiq) ---
# 0 — botni ishga tushirmaslik (Railway'dagi bot bilan 409 Conflict bo'lmasligi uchun)
# BOT_ENABLED=0
# 1 — X-Dev-User: <id> sarlavhasi bilan kirish
# DEV_AUTH=1
# 1 — admin yo'q bo'lsa, birinchi /start bosgan admin bo'ladi
# AUTO_ADMIN=1

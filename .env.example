# --- Majburiy ---
# @BotFather bergan token (Railway'da vaqtincha "taomkeldi_bot" nomi ham qabul qilinadi)
BOT_TOKEN=
# Platforma administratorlari: Telegram ID'lar, vergul bilan. (ADMIN_CHAT_ID — eski nom, ham o'qiladi)
PLATFORM_ADMIN_IDS=

# --- Saqlash ---
# Ma'lumotlar papkasi (Railway'da volume mount yo'li, masalan /data)
DATA_DIR=./data
# Ixtiyoriy: aniq yo'llar (standart: DATA_DIR/taomkeldi.db va DATA_DIR/uploads)
# DB_PATH=
# UPLOADS_DIR=

# --- HTTP / Mini App ---
# PORT=3000
# Mini App manzili, faqat HTTPS (4-bosqichda ishlatiladi)
# WEBAPP_URL=
# initData eskirish chegarasi, soniya (standart 86400)
# INITDATA_MAX_AGE_SEC=86400
# Rasm yuklash chegarasi, bayt (standart 5 MB)
# UPLOAD_MAX_BYTES=5242880

# --- Faqat lokal ishlab chiqish (production'da avtomatik o'chiq) ---
# 0 — botni ishga tushirmaslik (Railway'dagi bot bilan 409 Conflict bo'lmasligi uchun)
# BOT_ENABLED=0
# 1 — X-Dev-User: <id> sarlavhasi bilan kirish
# DEV_AUTH=1
# 1 — admin yo'q bo'lsa, birinchi /start bosgan admin bo'ladi
# AUTO_ADMIN=1
